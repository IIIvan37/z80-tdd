{
  "name": "z80-tdd",
  "version": "0.1.0",
  "private": true,
  "description": "Test Z80 routines of Amstrad CPC projects, test-first",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CREDITS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-wasm.ts",
    "build:wasm": "node scripts/build-wasm.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "node --use-env-proxy scripts/fetch-single-step-tests.ts && vitest run --config vitest.core.config.ts",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "depcruise": "depcruise src",
    "example": "pnpm build && tsc -p example && pnpm --dir example test",
    "gate": "pnpm typecheck && pnpm check && pnpm depcruise && pnpm test && pnpm example"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
